<!doctype html>
<html lang="de">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Set new password - aquaPi</title>
        <link rel="icon" href="{{ url_for('static', filename='favicon.ico') }}">
        <style>
            body {
                font-family: sans-serif;
                display: flex;
                align-items: center;
                justify-content: center;
                height: 100vh;
                margin: 0;
                background: #263238;
            }
            .login-box {
                background: #fff;
                border-radius: 4px;
                padding: 2em;
                width: 20em;
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
            }
            .login-box h1 {
                font-size: 1.4em;
                margin-top: 0;
            }
            .login-box label {
                display: block;
                margin-top: 1em;
                font-size: 0.9em;
            }
            .login-box input {
                width: 100%;
                box-sizing: border-box;
                padding: 0.5em;
                margin-top: 0.25em;
            }
            .login-box button {
                margin-top: 1.5em;
                width: 100%;
                padding: 0.6em;
                background: #00838f;
                color: #fff;
                border: none;
                border-radius: 4px;
                cursor: pointer;
            }
            .flash {
                color: #c62828;
                font-size: 0.9em;
            }
            .back-link {
                display: block;
                margin-top: 1em;
                font-size: 0.85em;
                text-align: right;
            }
            .back-link a {
                color: #00838f;
            }
        </style>
    </head>
    <body>
        <div class="login-box">
            <h1>Set new password</h1>
            {% with messages = get_flashed_messages() %}
                {% if messages %}
                    {% for msg in messages %}
                        <p class="flash">{{ msg }}</p>
                    {% endfor %}
                {% endif %}
            {% endwith %}
            {% if invalid %}
                <p class="flash">This reset link is invalid or has expired. Please request a new one.</p>
                <span class="back-link"><a href="{{ url_for('auth.request_password_reset') }}">Request a new link</a></span>
            {% else %}
                <form method="post">
                    <label for="password">New password</label>
                    <input type="password" id="password" name="password" autofocus required>
                    <label for="password2">Repeat new password</label>
                    <input type="password" id="password2" name="password2" required>
                    <button type="submit">Set password</button>
                </form>
                <span class="back-link"><a href="{{ url_for('auth.login') }}">Back to login</a></span>
            {% endif %}
        </div>
    </body>
</html>
