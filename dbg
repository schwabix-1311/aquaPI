#!/usr/bin/env bash

topo_file='topo'
while getopts "hrt:" arg; do
  case $arg in
    h*)
      echo "Parameters:"
      echo "-t NAME  use/create topology+config NAME (default: topo = the"
      echo "         real/production config; any other name bootstraps the"
      echo "         dev/test node set in its own instance/NAME.sqlite -"
      echo "         see instance/config.json's DEFAULT_CONFIG for a"
      echo "         persistent default instead of passing -t every time)"
      echo "-r       reset topology (both the legacy .pickle and the"
      echo "         actual .sqlite for the selected -t NAME)"
      exit 1
      ;;
    r)
      reset_topo=1
      ;;
    t)
      topo_file=$OPTARG
      ;;
    esac
  done

export AQUAPI_TOPO="${topo_file}.pickle"
if [[ ${reset_topo} ]]; then
  rm -f "instance/${topo_file}.pickle" "instance/${topo_file}.sqlite"
fi

export FLASK_APP=aquaPi
export FLASK_DEBUG=1

flask run --host "$(hostname -i|cut -d ' ' -f 1)"
