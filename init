#!/usr/bin/env bash

# Raspi OS (Debian) and Manjaro (Arch) differ in $0 for sourced scripts
# BASH_SOURCE is always the script, sourced or executed
# BASH_ARGV0 is the script or "-bash" (when sourced)
MySelf=$(realpath "$BASH_SOURCE")
MyHome=$(dirname "$MySelf")

QuestRel="7.4.2"  # last 7.x release (QuestDB moved to 8.0.0 next); upgraded
                  # from 7.1.3 2026-08-12, verified against this project's
                  # queries - see AGENTS.md/git history for details
JavaRel="17"
Envir=${1:-"Devel"}   # else "Prod"

if [[ $(basename -- "$BASH_ARGV0") = $(basename -- "${MySelf}") ]]
then
  echo "ERROR: this script must be sourced: '. ${MySelf}/init'"
  exit 10
  fi

if [ -n "$ZSH_VERSION" ]
then
  echo "ERROR: this script supports _bash_ only, sorry"
  return 11
  fi

if [[ ! -d "${MyHome}/venv" ]]
then
  echo "First time init of aquaPi development env."
  read -p "CR to continue / Ctrl-C to cancel" dummy
  cd "${MyHome}" || return 12

  # a customer install extracted from a release tarball (see install.sh)
  # has no .git directory at all - its tc420 submodule content is already
  # bundled directly into that tarball for exactly this reason, so there's
  # nothing to init/update there. Only a real git checkout (the dev path)
  # needs this.
  if [ -d .git ]
  then
    git submodule init
    git submodule update
    fi

  # a dev box routinely SSHes into whatever hardware you're working on
  # (a Pi over Wi-Fi, say) - without a keepalive, a dropped connection can
  # hang silently for hours before anything notices. Host-agnostic ("Host
  # *"), since this repo has no way to know your actual target(s); only
  # added if nothing already sets a catch-all block, so an existing
  # customization is never touched.
  if [ ! -f ~/.ssh/config ] || ! grep -q "^Host \*$" ~/.ssh/config
  then
    echo "===== adding resilient SSH defaults for any host (~/.ssh/config)"
    mkdir -p ~/.ssh
    chmod 700 ~/.ssh
    { echo ""; echo "Host *"; echo "    ServerAliveInterval 15"; \
      echo "    ServerAliveCountMax 3"; echo "    ConnectTimeout 10"; } >> ~/.ssh/config
    chmod 600 ~/.ssh/config
    fi

  # Debian derivatives don't come with py3 venv by default
  grep -i debian /usr/lib/os-release && sudo apt-get install python3-venv
  # ... likewise python3-dev, which is needed for "pip install --use-pep517 .."
  grep -i debian /usr/lib/os-release && sudo apt-get install python3-dev

  # NOTE: You can append --system-site-packages to inherit all
  #       packages installed globally, e.g. your vim's jedi. The
  #       release environment should not, to ensure requirements are complete.
  if [ ${Envir^^} == "DEVEL" ]
  then
    python3 -m venv venv --system-site-packages
  else
    python3 -m venv venv
  fi
fi

echo "Activate aquaPi development env."
cd "${MyHome}" || return 12
. ./venv/bin/activate
echo "===== get all python packages"
pip3 install --use-pep517 -r requirements.txt
echo "====="

if [ $(getconf LONG_BIT) == 64 ]
then
  if ( grep -i "Raspberry Pi" /proc/cpuinfo >/dev/null )
  then
    quest_on_pi=1
    quest_sh="${MyHome}/questdb-${QuestRel}/questdb.sh"
    if [ -z "$(ls -d "${MyHome}/questdb-${QuestRel}/" 2>/dev/null)" ]
    then
      echo "===== install Quest DB & OpenJDK JRE"
      quest_tgz="questdb-${QuestRel}-no-jre-bin.tar.gz"
      if [ ! -f "${quest_tgz}" ]
      then
        curl -LO "https://github.com/questdb/questdb/releases/download/${QuestRel}/${quest_tgz}"
      fi
      tar -xvf "${quest_tgz}"
      mv questdb-${QuestRel}-no-jre-bin questdb-${QuestRel}

      sudo apt install openjdk-${JavaRel}-jre-headless -y
    fi

    # -Xmx alone only caps the JVM heap - off-heap direct buffers,
    # metaspace, GC threads and per-thread stacks are all uncapped by
    # default and can each add well past the heap cap on a box this
    # small (QuestDB's Cairo storage engine is off-heap-mmap-heavy by
    # design). Checked/injected independent of the tarball-install
    # block above (like server.conf), so it also lands on an
    # already-installed production QuestDB on the next ./init run.
    if ( ! grep -- "-Xmx" "${quest_sh}" >/dev/null )
    then
      echo "===== capping QuestDB JVM heap/off-heap/stack for low-memory Pi"
      sed -i "s/-XX:+UseParallelGC/-XX:+UseParallelGC\\n  -Xms32M\\n  -Xmx128M\\n  -XX:MaxDirectMemorySize=64M\\n  -XX:MaxMetaspaceSize=64M\\n  -XX:ParallelGCThreads=1\\n  -XX:ConcGCThreads=1\\n  -Xss512k/" "${quest_sh}"
    fi

    # AlwaysPreTouch (QuestDB's own default) commits and writes every
    # heap page at startup. On a swap-backed Pi with aquaPi's rare-write
    # workload that's ~100MB of cold pages the kernel then parks in swap
    # for good. Turn it off - the last -XX flag on the line wins, so we
    # append -XX:-AlwaysPreTouch after the + one. Line-checked (not gated
    # on the -Xmx block above) so it also reaches an already-capped
    # production install on the next ./init run.
    if ( grep -- "-XX:+AlwaysPreTouch" "${quest_sh}" >/dev/null \
         && ! grep -- "-XX:-AlwaysPreTouch" "${quest_sh}" >/dev/null )
    then
      echo "===== disabling QuestDB JVM AlwaysPreTouch (swap-friendly)"
      sed -i "s/-XX:+AlwaysPreTouch/-XX:+AlwaysPreTouch -XX:-AlwaysPreTouch/" "${quest_sh}"
    fi

    export JAVA_HOME=/usr/lib/jvm/java-${JavaRel}-openjdk-arm64
  else
    quest_on_pi=0
    quest_sh="${MyHome}/questdb-${QuestRel}/bin/questdb.sh"
    if [ -z "$(ls -d "${MyHome}/questdb-${QuestRel}/" 2>/dev/null)" ]
    then
      echo "===== install Quest DB incl. JRE for AMD64"
      quest_tgz="questdb-${QuestRel}-rt-linux-amd64.tar.gz"
      if [ ! -f "${quest_tgz}" ]
      then
        curl -LO "https://github.com/questdb/questdb/releases/download/${QuestRel}/${quest_tgz}"
      fi
      tar -xvf "${quest_tgz}"
      mv questdb-${QuestRel}-rt-linux-amd64 questdb-${QuestRel}
    fi
  fi

  # QuestDB reads its config from its root dir (questdb.sh's default
  # -d ~/.questdb), not from the tarball's conf/. QuestDB writes its
  # default conf files there on first start, unless they already exist.
  quest_root_conf="${HOME}/.questdb/conf"

  # At INFO, QuestDB logs several lines per Postgres-wire connection and
  # table write - aquaPi connects per history value, which grew the log
  # by ~1GB/month on the Pi. The stdout writer's file is never rotated.
  if ( grep -q "^w.stdout.level=INFO" "${quest_root_conf}/log.conf" 2>/dev/null )
  then
    echo "===== reducing QuestDB log level to errors"
    # (\r?: QuestDB's shipped conf files can have CRLF line ends)
    sed -i "s/^w.stdout.level=INFO\(\r\?\)$/w.stdout.level=ERROR,CRITICAL,ADVISORY\1/" "${quest_root_conf}/log.conf"
  fi

  # server.conf keys aquaPi needs, enforced on every run: an existing
  # key gets its value replaced, a missing one is appended. Keys not
  # listed here stay as they are, hand-edits included.
  quest_server_conf="${quest_root_conf}/server.conf"
  quest_conf_set() {
    if ( ! grep -q "^$1=$2"$'\r'"\?$" "${quest_server_conf}" 2>/dev/null )
    then
      echo "===== QuestDB server.conf: $1=$2"
      if ( grep -q "^$1=" "${quest_server_conf}" 2>/dev/null )
      then
        sed -i "s/^$1=[^"$'\r'"]*/$1=$2/" "${quest_server_conf}"
      else
        echo "$1=$2" >> "${quest_server_conf}"
      fi
    fi
  }
  mkdir -p "${quest_root_conf}"

  # usage events nobody reads, in tables growing ~100MB over 2 years
  quest_conf_set telemetry.enabled false
  if [ "${quest_on_pi}" -eq 1 ]
  then
    # aquaPi only talks to QuestDB via the Postgres wire protocol
    # (psycopg) - the web console/REST API, ILP ingestion and the
    # health-check server are unused, cost memory, and the console
    # would accept any SQL from the whole LAN without a login. A single
    # Flask process doing light, low-frequency reads/writes doesn't
    # need more than 1 shared worker.
    quest_conf_set shared.worker.count 1
    quest_conf_set http.enabled false
    quest_conf_set http.min.enabled false
    quest_conf_set line.tcp.enabled false
    quest_conf_set line.udp.enabled false
  fi

  if ( "${quest_sh}" status 2>/dev/null | grep -q "^PID:" )
  then
    quest_running=1
  else
    quest_running=0
  fi

  read -t 10 -p "Start QuestDB now? [Y/n] (auto-Yes in 10s) " quest_answer
  echo
  if [[ -z "${quest_answer}" || "${quest_answer}" =~ ^[Yy] ]]
  then
    if [ "${quest_running}" -eq 0 ]
    then
      echo "===== starting Quest DB"
      "${quest_sh}" start
    fi
  else
    if [ "${quest_running}" -eq 1 ]
    then
      echo "===== stopping Quest DB"
      "${quest_sh}" stop
    fi
  fi

  pip3 install 'psycopg[binary]>=3.1.9'
  if [ -n "${quest_conf:-}" ] && grep -q "^http.enabled=false" "${quest_conf}" 2>/dev/null
  then
    echo "Quest DB's web console is disabled (http.enabled=false) to save memory."
  else
    echo "You can interact with Quest DB in your browser at localhost:9000"
  fi
  echo "====="
fi

echo "There are two scripts to run the development server:"
echo "  './run' should be used to start the software in a SSH"
echo "     shell, termination of the shell will not hang up (HUP)"
echo "     the process, and output is tee-ed to run.log"
echo "  './dbg' starts without output redirect to allow debugger"
echo "     interaction. If used via SSH the process will die"
echo "     when you close the shell."
echo "Use your browser to see the UI at 'http://$(hostname -i):5000'"
