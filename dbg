#!/usr/bin/env bash

wiring_file='wiring'
while getopts "hrw:" arg; do
  case $arg in
    h*)
      echo "Parameters:"
      echo "-w NAME  use/create wiring+config NAME (default: wiring = the"
      echo "         real/production config; any other name bootstraps the"
      echo "         dev/test node set in its own instance/NAME.sqlite -"
      echo "         see instance/config.json's DEFAULT_CONFIG for a"
      echo "         persistent default instead of passing -w every time)"
      echo "-r       reset wiring (both the legacy .pickle and the"
      echo "         actual .sqlite for the selected -w NAME)"
      exit 1
      ;;
    r)
      reset_wiring=1
      ;;
    w)
      wiring_file=$OPTARG
      ;;
    esac
  done

export AQUAPI_WIRING="${wiring_file}.pickle"
if [[ ${reset_wiring} ]]; then
  rm -f "instance/${wiring_file}.pickle" "instance/${wiring_file}.sqlite"
fi

# --- ONE-TIME MIGRATION (ScheduleInput: cronspec -> frequency/duration/anchor/weekdays) ---
# --- run once on production, then commit the removal                                    ---
if [ -f "instance/${wiring_file}.sqlite" ]; then
  python3 -c "
import json
import sqlite3
conn = sqlite3.connect('instance/${wiring_file}.sqlite')
conn.row_factory = sqlite3.Row
row = conn.execute(\"SELECT id, params FROM nodes WHERE id = 'zeitplanlicht' AND type = 'ScheduleInput'\").fetchone()
if row:
    params = json.loads(row['params'])
    if 'cronspec' in params:
        del params['cronspec']
        params['frequency'] = 86400
        params['duration'] = 28800
        params['anchor'] = '14:00'
        params['weekdays'] = None
        conn.execute('UPDATE nodes SET params = ? WHERE id = ?', (json.dumps(params), row['id']))
        conn.commit()
        print('One-time migration: zeitplanlicht cronspec -> frequency/duration/anchor/weekdays')
conn.close()
"
fi
# --- END ONE-TIME MIGRATION ---

# --- ONE-TIME MIGRATION (ScaleAux: offset/factor -> 2-point calibration) ---
# --- run once on production, then commit the removal                    ---
if [ -f "instance/${wiring_file}.sqlite" ]; then
  python3 -c "
import json
import sqlite3

# real, human-meaningful points for the two nodes the shipped templates'
# own offset/factor were themselves back-solved from (user-confirmed) -
# used in place of the synthetic fallback below when the id matches
KNOWN_POINTS = {
    'phwert': [{'measured': 2.99, 'reference': 4.0}, {'measured': 2.51, 'reference': 6.9}],
    'lueftersteuerung': [{'measured': 26.0, 'reference': 0}, {'measured': 28.0, 'reference': 100}],
}

def synthesize_points(node_id, params):
    if node_id in KNOWN_POINTS:
        params.pop('offset', None)
        params.pop('factor', None)
        params['points'] = KNOWN_POINTS[node_id]
        return
    # exact, not approximate: (0, offset) / (1, factor + offset) round-trips
    # to the very same offset/factor - see [[project ScaleAux 2-point-only]]
    offset = params.pop('offset', 0.0)
    factor = params.pop('factor', 1.0)
    params['points'] = [
        {'measured': 0, 'reference': offset},
        {'measured': 1, 'reference': factor + offset},
    ]

conn = sqlite3.connect('instance/${wiring_file}.sqlite')
conn.row_factory = sqlite3.Row
migrated = []

for row in conn.execute(\"SELECT id, params FROM nodes WHERE type = 'ScaleAux'\").fetchall():
    params = json.loads(row['params'])
    if 'points' not in params:
        synthesize_points(row['id'], params)
        conn.execute('UPDATE nodes SET params = ? WHERE id = ?', (json.dumps(params), row['id']))
        migrated.append('nodes/' + row['id'])

has_snapshots = conn.execute(
    \"SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'wiring_snapshots'\"
).fetchone()
if has_snapshots:
    for row in conn.execute('SELECT name, data FROM wiring_snapshots').fetchall():
        data = json.loads(row['data'])
        changed = False
        for node in data:
            if node.get('type') == 'ScaleAux' and 'points' not in node.get('params', {}):
                synthesize_points(node.get('id'), node['params'])
                changed = True
        if changed:
            conn.execute('UPDATE wiring_snapshots SET data = ? WHERE name = ?', (json.dumps(data), row['name']))
            migrated.append('wiring_snapshots/' + row['name'])

if migrated:
    conn.commit()
    print('One-time migration: ScaleAux offset/factor -> points for', ', '.join(migrated))
conn.close()
"
fi
# --- END ONE-TIME MIGRATION ---

export FLASK_APP=aquaPi
export FLASK_DEBUG=1

flask run --host "$(hostname -i|cut -d ' ' -f 1)"
